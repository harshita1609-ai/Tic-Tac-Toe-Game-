*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{

    min-height:100vh;

    display:flex;

    justify-content:center;

    align-items:center;

    overflow-x:hidden;

    background:#07152d;

    color:white;

}

.background{

    position:fixed;

    inset:0;

    background:
    radial-gradient(circle at top left,#7f5af0,transparent 35%),
    radial-gradient(circle at bottom right,#00c2ff,transparent 35%),
    #07152d;

    animation:move 12s infinite alternate;

    z-index:-2;

}

@keyframes move{

0%{

transform:scale(1);

}

100%{

transform:scale(1.2);

}

}

.container{

    width:min(95%,900px);

    padding:35px;

    border-radius:25px;

    backdrop-filter:blur(18px);

    background:rgba(255,255,255,.08);

    border:1px solid rgba(255,255,255,.2);

    box-shadow:0 25px 60px rgba(0,0,0,.35);

}

h1{

    text-align:center;

    font-size:3rem;

    margin-bottom:25px;

    color:#ffffff;

}

.controls{

    display:flex;

    justify-content:center;

    gap:15px;

    margin-bottom:25px;

}

button{

    cursor:pointer;

    border:none;

    padding:12px 22px;

    border-radius:12px;

    font-size:16px;

    font-weight:600;

    color:white;

    background:linear-gradient(45deg,#6c63ff,#00bcd4);

    transition:.3s;

}

button:hover{

    transform:translateY(-4px);

    box-shadow:0 12px 20px rgba(0,0,0,.3);

}

.scoreboard{

    display:flex;

    justify-content:space-between;

    gap:20px;

    margin-bottom:25px;

}

.card{

    flex:1;

    text-align:center;

    padding:18px;

    border-radius:18px;

    background:rgba(255,255,255,.1);

}

.card h2{

    margin-bottom:8px;

}

.card span{

    font-size:2rem;

    font-weight:bold;

}

.playerInfo{

    display:flex;

    gap:15px;

    margin-bottom:25px;

}

.playerInfo input{

    flex:1;

    padding:14px;

    border:none;

    border-radius:10px;

    outline:none;

    font-size:16px;

}

.status{

    text-align:center;

    font-size:1.4rem;

    margin-bottom:10px;

}

.timer{

    text-align:center;

    font-size:1.2rem;

    margin-bottom:25px;

}

.board{

    display:grid;

    grid-template-columns:repeat(3,130px);

    grid-template-rows:repeat(3,130px);

    gap:15px;

    justify-content:center;

    margin:auto;

}

.cell{

    background:rgba(255,255,255,.1);

    border-radius:20px;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:4rem;

    cursor:pointer;

    transition:.3s;

    user-select:none;

}

.cell:hover{

    background:rgba(255,255,255,.2);

    transform:scale(1.06);

}

.buttons{

    display:flex;

    flex-wrap:wrap;

    justify-content:center;

    gap:15px;

    margin-top:35px;

}

.stats{

    margin-top:40px;

    background:rgba(255,255,255,.08);

    border-radius:20px;

    padding:25px;

}

.stats h2{

    text-align:center;

    margin-bottom:15px;

}

.stats p{

    margin:10px 0;

}

@media(max-width:768px){

.board{

grid-template-columns:repeat(3,90px);

grid-template-rows:repeat(3,90px);

}

.cell{

font-size:3rem;

}

.scoreboard{

flex-direction:column;

}

.playerInfo{

flex-direction:column;

}

.buttons{

flex-direction:column;

}

h1{

font-size:2.2rem;

}

}
